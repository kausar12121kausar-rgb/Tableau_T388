      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0134200588877825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Price Category ' datatype='string' name='[Calculation_0134200590675970]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; 300 THEN &quot;luxuary&quot; ELSEIF [Price] &gt; 150 THEN &quot;Standard&quot; ELSE &quot;Budget&quot; END' />
      </column>
      <column caption='Count Of Hotels' datatype='integer' name='[Calculation_0134200593592323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0134200597491716]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt; TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category ' datatype='string' name='[Calculation_0134200598315013]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0134200600207368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0134200599179270]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since_New' datatype='date' name='[Calculation_0134200607047691]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review_Score_Rating_New' datatype='integer' name='[Calculation_0134200609177612]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating (bin)],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column datatype='integer' hidden='true' name='[Review Scores Rating (bin)]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
